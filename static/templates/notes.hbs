<!DOCTYPE html>
<html lang="en">
{{>html_header}}
<body>
<div class="content-area">
  {{>site_header}}
  <main>
    <h1>Notes</h1>
    <ul>
    {{#each posts}}
      <p><i class="xm_timestamp">{{this.created}}</i>&nbsp;<a href="/notes/post/{{this.id}}">{{this.title}}</a></p>
    {{else}}
      <p>There are no posts yet.</p>
    {{/each}}
    </ul>
  </main>
  {{>site_footer}}
</div>
</body>
</html>
